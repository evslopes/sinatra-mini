tmp/
temp/

# Spring Boot
spring.log
hs_err_pid*

# Environment variables (segurança)
.env
.env.local
.env.*.local

# Flyway config with credentials (usar flyway.conf.example)
flyway.conf

# Database local
*.db
*.sqlite

# H2 database files
*.h2.db
*.mv.db
*.trace.db



