# Java / Maven / Spring standard ignores

# Build output
target/

# Maven wrapper
/.mvn/
/.mvnw
/.mvnw.cmd

# Compiled class files
*.class

# Log files
logs/
*.log

# Package files
*.jar
*.war
*.ear

# Eclipse
.classpath
.project
.settings/

# IntelliJ
*.iml
.idea/

# NetBeans
/nbproject/private/
/build/
/nbbuild/
/dist/

# VS Code
.vscode/

# OS files
.DS_Store

# Temporary files
tmp/
temp/

# Spring Boot
spring.log
hs_err_pid*

# Environment variables (segurança)
.env
.env.local
.env.*.local

# Flyway config with credentials (usar flyway.conf.example)
flyway.conf

# Database local
*.db
*.sqlite

# H2 database files
*.h2.db
*.mv.db
*.trace.db

